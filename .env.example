# PostgreSQL
POSTGRES_PASSWORD=changeme_in_production

# Sessions (generate with: openssl rand -hex 32)
SESSION_SECRET=changeme_in_production

# Domain (for Caddy HTTPS)
APP_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
CADDYFILE=./Caddyfile

# Upload storage path (inside container, mapped to Docker volume)
UPLOAD_DIR=/uploads

# Public app URL (used in email links)
APP_URL=https://localhost

# SMTP (optional — if not set, emails are only logged to console)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@mg.yourdomain.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Brandywine <noreply@yourdomain.com>

# ── Running the app or worker outside Docker (development) ─────────────────
# Start PostgreSQL and Redis with published ports first:
#   docker compose -f docker-compose.yml -f compose.dev.yml up -d db redis
# DATABASE_URL=postgresql://brandywine:changeme_in_production@localhost:5432/brandywine
# REDIS_URL=redis://localhost:6379
# UPLOAD_DIR=../uploads
