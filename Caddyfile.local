http://localhost {
	reverse_proxy app:3000
	encode zstd gzip
	request_body {
		max_size 210MB
	}
	header {
		-X-Powered-By
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

https://localhost {
	reverse_proxy app:3000
	encode zstd gzip
	request_body {
		max_size 210MB
	}
	header {
		-X-Powered-By
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
