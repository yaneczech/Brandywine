{
	"name": "brandywine",
	"description": "Self-hosted brand manual and asset platform — web app",
	"private": true,
	"version": "0.0.1",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/yaneczech/Brandywine.git",
		"directory": "app"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"lint": "eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/bcryptjs": "^2.4.6",
		"@typescript-eslint/eslint-plugin": "^8.60.1",
		"@typescript-eslint/parser": "^8.60.1",
		"@vitest/ui": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.24.1",
		"@material-symbols/svg-400": "0.47.5",
		"@types/nodemailer": "^8.0.0",
		"@types/pg": "^8.20.0",
		"bcryptjs": "^3.0.3",
		"bullmq": "^5.78.0",
		"drizzle-orm": "^0.45.2",
		"ioredis": "^5.11.1",
		"nodemailer": "^9.0.5",
		"postgres": "^3.4.9",
		"sharp": "^0.35.3"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
